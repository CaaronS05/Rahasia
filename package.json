{
  "name": "meteora-wallet-scanner-v1",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "scrape:lpagent": "node scripts/lpagent/scrape-smart-lp.mjs",
    "refresh:lpagent": "node scripts/lpagent/scrape-smart-lp.mjs && node --experimental-strip-types scripts/pipeline/merge-wallets.ts data/raw/lpagent/smart-lp-latest.json",
    "merge:wallets": "node --experimental-strip-types scripts/pipeline/merge-wallets.ts",
    "enrich:fabriq": "node scripts/fabriq/enrich-wallets.mjs",
    "control": "node scripts/control/server.mjs",
    "merge:fabriq": "node --experimental-strip-types scripts/pipeline/merge-fabriq.ts",
    "publish:wallets": "node --experimental-strip-types scripts/pipeline/publish-wallets.ts",
    "pipeline": "node scripts/pipeline/run-pipeline.mjs",
    "waldisc:test-one-pool": "node --experimental-strip-types --env-file=.env scripts/discovery/waldisc-1-test-one-pool.ts",
    "test": "node --experimental-strip-types --test tests/analytics/position-analytics.test.ts tests/analytics/position-metrics.test.ts tests/analytics/position-analytics-control-api.test.ts tests/analytics/monitoring-assessment.test.ts tests/control/worker-defaults.test.ts tests/analytics/meteora-verification-adapter.test.ts",
    "test:analytics": "node --experimental-strip-types --test tests/analytics/position-analytics.test.ts tests/analytics/position-metrics.test.ts tests/analytics/position-analytics-control-api.test.ts tests/analytics/monitoring-assessment.test.ts tests/analytics/meteora-verification-adapter.test.ts"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/ws": "^8.18.1",
    "playwright": "^1.63.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@meteora-ag/dlmm": "^1.9.14",
    "@solana/web3.js": "^1.99.0",
    "bs58": "^6.0.0",
    "playwright-core": "^1.63.0",
    "ws": "^8.21.3"
  }
}
