# Required
HELIUS_API_KEY=your_helius_api_key_here

# Meteora DLMM program (official lb_clmm program)
METEORA_DLMM_PROGRAM_ID=LBUZKhRxPF3XUpBCjp4YzTKgLccjZhTSDM9YuVaPwxo

# Scan window
SCAN_DAYS=7

# auto = try Helius getTransactionsForAddress, then fallback to standard RPC
# gtfa = require getTransactionsForAddress
# standard = getSignaturesForAddress + getTransaction
SCAN_MODE=auto

# Conservative defaults
GTFA_PAGE_SIZE=100
STANDARD_SIGNATURE_PAGE_SIZE=1000
GET_TX_CONCURRENCY=8
REQUEST_RETRIES=6

# 0 = unlimited. Useful for a smoke test, e.g. 5000
MAX_TRANSACTIONS=0
